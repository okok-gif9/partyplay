# Public browser configuration only. Do not add service-role keys here.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_public_key
# Public VAPID key for Web Push subscriptions. Keep the matching private key only in Supabase secrets.
VITE_PARTYPLAY_WEB_PUSH_PUBLIC_KEY=your_public_vapid_key
